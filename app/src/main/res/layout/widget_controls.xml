<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/widget_prev"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="Précédent"
        android:src="@drawable/ic_widget_prev" />

    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="52dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="Lecture ou pause"
        android:src="@drawable/ic_widget_play" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="Suivant"
        android:src="@drawable/ic_widget_next" />
</LinearLayout>
